#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: NPMjs Proxy (Verdaccio)
# s6-overlay service: generates Verdaccio config from add-on options and
# starts the registry. (s6 docs: https://github.com/just-containers/s6-overlay)
# ==============================================================================

set -e

CONFIG_FILE="/etc/verdaccio/config.yaml"
DATA_DIR="/data/verdaccio"
STORAGE_DIR="${DATA_DIR}/storage"
HTPASSWD_FILE="${DATA_DIR}/htpasswd"
OPTIONS_FILE="/data/options.json"

# ------------------------------------------------------------------------------
# Read one add-on option.
# Primary: Supervisor API via bashio (Home Assistant OS sets SUPERVISOR_TOKEN).
# Fallback: /data/options.json via jq (plain `docker run`, where the
# Supervisor API is unavailable — modern bashio blocks/retries on the API
# instead of falling back, so we must not call it at all there).
# ------------------------------------------------------------------------------
if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    USE_SUPERVISOR_API="true"
else
    USE_SUPERVISOR_API="false"
fi

get_option() {
    local key="${1}" default="${2}" val=""
    if [ "${USE_SUPERVISOR_API}" = "true" ]; then
        if val="$(bashio::config "${key}" 2>/dev/null)" \
            && bashio::var.has_value "${val}" \
            && [ "${val}" != "null" ]; then
            printf '%s' "${val}"
            return 0
        fi
    fi
    if [ -f "${OPTIONS_FILE}" ] && command -v jq >/dev/null 2>&1; then
        val="$(jq -r --arg k "${key}" --arg d "${default}" \
            '.[$k] // $d | if type == "boolean" then (if . then "true" else "false" end) else tostring end' \
            "${OPTIONS_FILE}" 2>/dev/null)" \
        && bashio::var.has_value "${val}" \
        && [ "${val}" != "null" ] \
        && printf '%s' "${val}" \
        && return 0
    fi
    printf '%s' "${default}"
}

LOG_LEVEL="$(get_option 'log_level' 'info')"
UPLINK="$(get_option 'uplink' 'https://registry.npmjs.org/')"
MAXAGE="$(get_option 'maxage' '30m')"
TIMEOUT="$(get_option 'timeout' '30s')"
MAX_BODY_SIZE="$(get_option 'max_body_size' '32mb')"
ALLOW_OFFLINE="$(get_option 'allow_offline' 'true')"
ALLOW_PUBLISH="$(get_option 'allow_publish' 'false')"
ENABLE_WEB="$(get_option 'enable_web' 'false')"

bashio::log.info "Starting NPMjs Proxy..."
bashio::log.info "Upstream uplink: ${UPLINK}"
bashio::log.info "Cache maxage: ${MAXAGE}, offline allowed: ${ALLOW_OFFLINE}"

mkdir -p "${STORAGE_DIR}"
mkdir -p "$(dirname "${CONFIG_FILE}")"
mkdir -p "/etc/verdaccio/plugins"

# htpasswd file must exist for auth block (even when publish is disabled)
if ! bashio::fs.file_exists "${HTPASSWD_FILE}"; then
    touch "${HTPASSWD_FILE}"
    bashio::log.info "Created empty htpasswd file at ${HTPASSWD_FILE}"
fi

# Map allow_publish -> max_users
# false (default, caching-only): -1 disables new user signup, so proxy is
# effectively read-only but still caches upstream tarballs.
# true: allow signup + publish of private packages.
if bashio::var.true "${ALLOW_PUBLISH}"; then
    MAX_USERS="1000"
    bashio::log.info "Private publish ENABLED (max_users=1000)"
else
    MAX_USERS="-1"
    bashio::log.info "Private publish DISABLED (caching mirror mode, max_users=-1)"
fi

# Map allow_offline -> offline_publish (can `npm publish` while upstream down)
if bashio::var.true "${ALLOW_OFFLINE}"; then
    OFFLINE_PUBLISH="true"
else
    OFFLINE_PUBLISH="false"
fi

# Map enable_web -> web.enable
if bashio::var.true "${ENABLE_WEB}"; then
    WEB_ENABLE="true"
else
    WEB_ENABLE="false"
fi

# ------------------------------------------------------------------------------
# Generate Verdaccio 6 config
# Docs: https://verdaccio.org/docs/configuration
# ------------------------------------------------------------------------------
cat > "${CONFIG_FILE}" <<EOF
# Auto-generated by Home Assistant add-on npmjs-proxy. DO NOT EDIT.
storage: ${STORAGE_DIR}
plugins: /etc/verdaccio/plugins
max_body_size: ${MAX_BODY_SIZE}

web:
  enable: ${WEB_ENABLE}
  title: NPMjs Proxy

auth:
  htpasswd:
    file: ${HTPASSWD_FILE}
    max_users: ${MAX_USERS}

# Allow offline publish when upstream is unreachable (if enabled in options)
offline_publish: ${OFFLINE_PUBLISH}

uplinks:
  npmjs:
    url: ${UPLINK}
    timeout: ${TIMEOUT}
    maxage: ${MAXAGE}
    fail_timeout: 30s
    max_fails: 2
    cache: true

packages:
  '@*/*':
    access: \$all
    publish: \$authenticated
    unpublish: \$authenticated
    proxy: npmjs
  '**':
    access: \$all
    publish: \$authenticated
    unpublish: \$authenticated
    proxy: npmjs

server:
  keepAliveTimeout: 60

middlewares:
  audit:
    enabled: true

log: { type: stdout, format: pretty, level: ${LOG_LEVEL} }
EOF

bashio::log.info "Wrote Verdaccio config to ${CONFIG_FILE}"

# Listen on all interfaces so the Supervisor port mapping (4873/tcp) works.
# s6 requires the service to run in the foreground (no daemonizing).
exec verdaccio --config "${CONFIG_FILE}" --listen 0.0.0.0:4873
